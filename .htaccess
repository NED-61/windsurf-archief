# Gemaakt door tools/build_site.py (docs/bereikplan.md, B0.5). Geldt alleen voor deze map en wat eronder staat.
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
RewriteEngine On
RewriteRule ^versie\.txt$ - [L]
# Alles wat niet op het hoofdadres binnenkomt: 301 naar dezelfde pagina op het hoofdadres.
RewriteCond %{HTTP_HOST} !^windsurfarchief\.nl(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://windsurfarchief.nl/$1 [R=301,L]
# Een map zonder pagina: naar het overzicht in plaats van een 403.
RewriteRule ^rider/?$ https://windsurfarchief.nl/riders.html [R=301,L]
RewriteRule ^(wedstrijd|uitslag|reeks|jaar)/?$ https://windsurfarchief.nl/wedstrijden.html [R=301,L]
